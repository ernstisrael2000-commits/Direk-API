# ── Serveur ──────────────────────────────────────────────────────────────────
SESSION_SECRET=changez-moi-par-une-longue-chaine-aleatoire
PORT=3000
NODE_ENV=development

# ── Supabase ─────────────────────────────────────────────────────────────────
# Supabase Dashboard → Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...     # service_role — JAMAIS exposé au frontend
SUPABASE_ANON_KEY=eyJhbGci...            # anon/public — utilisé pour OAuth PKCE

# ── URL publique (obligatoire en production) ──────────────────────────────────
# Utilisé pour le callback Google OAuth. Ne pas mettre de slash final.
# APP_URL=https://votredomaine.com

# ── Pay'm — passerelle de paiement haïtienne ──────────────────────────────────
# https://plopplop.solutionip.app
PAYM_CLIENT_ID=
PAYM_CLIENT_SECRET=

# ── FazerCards — fournisseur recharges jeux ───────────────────────────────────
# https://api.fzr.cards
FAZERCARDS_API_KEY=fc_

# ── Admin ─────────────────────────────────────────────────────────────────────
# Protège toutes les routes /api/v1/admin/*
# Header requis : Authorization: Bearer <ADMIN_SECRET>
ADMIN_SECRET=changez-moi-par-un-secret-fort
